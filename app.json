{
  "expo": {
    "name": "GroceryAI",
    "slug": "groceryai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "groceryai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.groceryai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10b981",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.groceryai.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
